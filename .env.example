# Notion connection token (Internal connection / API token)
# Create at https://app.notion.com/developers/connections
# (Settings → Connections → turn on Developer Mode → Internal connections)
# Then share each Command Center DB with the connection (••• → Connections)
NOTION_TOKEN=

# Notion data source IDs (API version 2025-09-03)
# Values also recorded in config/notion_command_center.json
NOTION_TASKS_DATA_SOURCE_ID=c7b4e9e4-d81a-442c-90ae-f49d8a8372c0
NOTION_COMPANIES_DATA_SOURCE_ID=d3544976-9f52-4d91-bc6b-9af680bd7745
NOTION_RESEARCH_DATA_SOURCE_ID=2c440fd7-21a5-4102-81c5-008ffe602cc7
NOTION_PROJECTS_DATA_SOURCE_ID=4945228c-3c75-413b-a2ea-85c39d860d06
NOTION_FUNDING_DATA_SOURCE_ID=fb8c3e32-edbe-4e6c-9db8-c8129e6e4cc0

# Parent page for the Command Center
NOTION_COMMAND_CENTER_PAGE_ID=3feb2287-3e66-818f-983a-de85647877b4

# Parent page for Telegram run outputs (child pages nest under this).
# Create "Telegram Agent Outputs" under Command Center, share with the integration,
# then paste the page ID here (or leave blank to auto-create under Command Center).
NOTION_OUTPUTS_PARENT_PAGE_ID=

# Optional: wrap existing extractors instead of built-ins
# AETHER_LEAD_EXTRACTOR=my_package.leads:extract_company
# AETHER_RESEARCH_EXTRACTOR=my_package.research:extract_findings

# LLM via OpenRouter (or any OpenAI-compatible endpoint)
# Used for free-text Telegram intent mapping when set
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Runtime limits (keep GitHub Actions + token spend under control)
AGENT_BATCH_LIMIT=10
AGENT_LLM_RETRY_LIMIT=1
AGENT_TOKEN_BUDGET=8000
AGENT_DRY_RUN=false

# Telegram front door (long polling inside aether-web / ECS chat task)
# 1. Talk to @BotFather → /newbot → copy token
# 2. Message your bot /start, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy your chat.id into TELEGRAM_ALLOWED_CHAT_IDS (comma-separated)
# 3. Set TELEGRAM_ENABLED=true and redeploy ECS / restart aether-web
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
